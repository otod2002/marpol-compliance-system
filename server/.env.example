# Copy this file to .env and fill in real values. Never commit .env itself.

# Same connection string used for the database setup steps, but pointing
# at the app_role account rather than postgres, once you've created it.
DATABASE_URL=postgresql://app_role:change-me-before-deployment@localhost:5432/marpol

# Generate with: openssl rand -hex 32  (or see PowerShell alternative in SETUP.md)
JWT_SECRET=

# Optional
PORT=4000
CORS_ORIGIN=
TOKEN_TTL=12h
